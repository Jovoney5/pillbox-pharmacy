# ── Email settings (Gmail SMTP) ───────────────────────────────────────────────
# Copy this file to ".env" and fill in your values. Never commit the real .env.
#
# Setup steps:
#   1. Turn on 2-Step Verification:  https://myaccount.google.com/security
#   2. Create an App Password:        https://myaccount.google.com/apppasswords
#      (choose "Mail" → "Other" → name it "PillBox")
#   3. Paste the 16-character password into MAIL_PASSWORD below (spaces are fine).

MAIL_ENABLED=true
MAIL_USERNAME=your.pharmacy@gmail.com
MAIL_PASSWORD=abcd efgh ijkl mnop
MAIL_FROM_NAME=The PillBox Pharmacy
MAIL_REPLY_TO=your.pharmacy@gmail.com

# ── Stripe (card payments) ────────────────────────────────────────────────────
# Use TEST keys from https://dashboard.stripe.com/test/apikeys for the demo.
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
CURRENCY=usd

# ── Site ──────────────────────────────────────────────────────────────────────
# Public URL of the deployed site — makes email links absolute (not localhost).
PUBLIC_BASE_URL=https://pillbox-pharmacy.onrender.com
# Flask session secret (Render generates one automatically in production).
SECRET_KEY=change-me-to-a-long-random-string
